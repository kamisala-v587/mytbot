{
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpvav3",
        "repo_id": "bprobotwin_clean",
        "repo_id_file": "/home/jovyan/workspace/mytbot/configs/ds_ids/B200/robotwin-clean-bp.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/home/jovyan/workspace/mytbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        // BP 任务对比损失需要 batch 内有多个任务。
        "homogeneous_batch": false,
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": true,
        "weight_rules_path": "/home/jovyan/workspace/mytbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/home/jovyan/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,

        // false 时当前观测不编码 instruction，也不调用 tokenizer。
        "use_language": false,
        "bp_num_chunks": 8,
        // true: 所有轨迹固定取 8 个关键帧 linspace(0, T-1, 8)，不再按 ceil(T/50) 决定 K。
        // 必须与 policy.bp_fixed_num_chunks 一致。
        "bp_fixed_num_chunks": true,
        // 样本带 bp_task_id（repo 上级目录名的 hash），供 policy.lambda_bp_task 使用。
        "bp_attach_task_id": true,
        "bp_seed": 0,
        // random: 同任务随机，可能抽到当前 episode。
        // origin: 示教就是当前轨迹整段。阶段 1 用，并且 lambda_bp_encoder 必须为 0。
        // avoid: 同任务随机，排除当前 episode。阶段 2 用。
        "bp_sampling_mode": "origin",

        // false: 示教 action 整段置零且 action_is_pad=true，避免 origin 直接抄当前轨迹。
        // 只保留部分维度写 "0:6" 或 "0:6,7:13"（右端不含）。Aloha 夹爪是 6 和 13。
        "bp_action_use": false,
        // 与 bp_action_use 相同。false 时 state 置零且 state_is_available=false。
        "bp_state_use": true,

        // 本轮先关掉 align。训练时按 bp_action_use / bp_state_use 选择示教维度。
        "align_bp_encoder": false,

        // 只过滤 future_prompt 里锚点早于当前帧的 chunk。
        "future_filter": true,
        "bp_camera_keys": [
            "observation.images.image0"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpvav3",
        // "pretrained_path": "/home/jovyan/workspace/models/q35/pt-15w", 
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/home/jovyan/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,
        "use_language": false,
        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [0],
        "num_camera_views": 3,
        "empty_cameras": 0,

        "bp_num_chunks": 8,
        "bp_fixed_num_chunks": true,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "bp_compressor_dim": 512,
        "bp_state_action_hidden_dim": 256,
        "bp_num_query_tokens": 8,
        "bp_compressor_num_layers": 2,
        "bp_compressor_num_heads": 8,
        "bp_compressor_ff_mult": 4,
        // 阶段 1 只算 action loss，让随机初始化的 BP 模块贴上 Q35。
        "bp_align_loss_type": "cosine", // 可选 cosine 或 mse；mse 使用未归一化特征
        "lambda_bp_encoder": 0,
        // BP encoder 输出（平均后经投影头）的同任务 SupCon 损失；投影头只服务于该损失，不进 VLM。
        "lambda_bp_task": 0.05,
        "bp_task_tau": 0.2,
        "bp_task_proj_dim": 256,
        // true 时只冻结 bp_obs_encoder 里 ViT 以外的部分：投影、MLP 和 compressor。
        "frozen_bp_encoder": false,
        // true 时冻结共享 Qwen3.5 ViT。当前观测和 BP 图像是同一份参数，两边都不再更新。
        "frozen_vit": true,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 4e-3,
        "max_period": 4.0,

        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 300,
        "scheduler_decay_steps": 3000,
        "scheduler_decay_lr": 5e-5
    },

    "output_dir": "outputs/BPv3/ex03_fixed8_taskcon/bpv3-clean-stage1",
    "resume": false,
    "seed": 42,
    "num_workers": 16,
    // B200 8 卡：单卡 32，全局 batch=256，与 Pro6k 4 卡 x 64 一致。
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 3000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 1000,
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": false,
        "project": "BPVAv3",
        "mode": "offline"
    },

    "rename_map": {}
}

{
    "dataset": {
        "type": "bpva",
        "repo_id": "bpva_pretrain_data",
        "repo_id_file": "/home/jovyan/workspace/mytbot/configs/ds_ids/B200/pretrain-data.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/home/jovyan/workspace/mytbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "pyav",
        "skip_video_file_validation": true, // 仅在确认本地视频完整时启用
        "streaming": false,
        "dist_loading": true,
        "weight_rules_path": "/home/jovyan/workspace/mytbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "qwen3_vl_processor_path": "/home/jovyan/workspace/models/Qwen3-vl-2b-instruct", // 仅加载图像处理器和视觉 token 配置，不加载语言 tokenizer

        "bp_num_chunks": 10, //所需action chunk 会根据policy配置动态修改
        "bp_same_episode_policy": "avoid",
        "bp_seed": 0,
        "bp_camera_keys": [
            "observation.images.image0",
            "observation.images.image1",
            "observation.images.image2"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpva",
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "qwen3_vl_variant": "qwen3_vl_28l",
        "action_expert_variant": "qwen3_28l",
        "qwen3_vl_pretrained_path": "/home/jovyan/workspace/models/Qwen3-vl-2b-instruct",

        "n_obs_steps": 1,
        "chunk_size": 50, // 模型预测步数
        "n_action_steps": 50, // 对外返回步数，推理用
        "max_state_dim": 32,
        "max_action_dim": 32,
        "attention_mask_mode": "default",

        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [-15, 0, 15],

        // BPVA 核心：BPObsEncoder 结构配置。保存/加载 checkpoint 时这些字段必须可复现。
        "bp_num_chunks": 10,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0",
            "observation.images.image1",
            "observation.images.image2"
        ],
        "bp_vision_model_name": "vit_base_patch16_clip_224.openai",
        "bp_vision_pretrained": true,
        // 需先用 hf download 下载到以下稳定路径；路径非空时仅加载本地 checkpoint，禁止联网。
        "bp_vision_checkpoint_path": "/home/jovyan/workspace/models/timm-vit_base_patch16_clip_224.openai/open_clip_model.safetensors",
        "bp_token_dim": 768, // bp encoder 中间维度，后续统一为2048
        "bp_image_feature_aggregation": "cls",
        "bp_share_rgb_model": true,
        "bp_use_vision_norm": true,
        "bp_freeze_vision_encoder": false, 
        "bp_use_action_step_embedding": true,
        "bp_use_modality_type_embedding": true,
        "bp_use_chunk_position_embedding": true,

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        "gradient_checkpointing": false, 
        "freeze_vision_encoder": false,
        "train_expert_only": false,
        "train_vlm_only": false,

        "optimizer_lr": 5e-5, 
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 125,
        "scheduler_decay_steps": 300000, 
        "scheduler_decay_lr": 5e-5, 

        "scale_factor": 8,
        "lambda_gen": 0.01,
        "cosmos_tokenizer_path_or_name": "/home/jovyan/workspace/models/nvidia-cosmos-tokwnizer-ci8x8",

        "enable_3d_queries": true,
        "num_3d_query_tokens": 432,
        "da3_alignment_mode": "query_decoder",
        "da3_query_resampler_layers": 1,
        "da3_query_resampler_ff_mult": 1,
        "query_layer_indices": [13, 19, 23, 27],
        "da3_variant": "auto",
        "da3_teacher_layers": [11, 15, 19, 23],
        "da3_query_dim": 2048,
        "da3_tokens_per_view": 1296,
        "da3_num_views": 3,
        "lambda_3d": 0.01,
        "da3_model_path_or_name": "/home/jovyan/workspace/models/DA3-LARGE-1.1",
        "da3_code_root": "/home/jovyan/workspace/mytbot/third_party/Depth-Anything-3",
        "da3_teacher_process_res": 504,
        "da3_layer_weights": [1.0, 1.2, 1.4, 1.6],
        "log_da3_teacher_timing": true

        // "mask_action_dim_padding_loss": true, // 截断计算loss
        // "action_loss_valid_dim": 14 // 截断计算loss
    },

    "output_dir": "outputs/BPVA/pretrain",
    "job_name": "v0.1",
    "resume": false,
    "seed": 42,
    "num_workers": 12,
    "batch_size": 12,
    "gradient_accumulation_steps": 1,
    "steps": 300000,
    "eval_freq": 100, 
    "log_freq": 10, 
    "save_checkpoint": true,
    "save_freq": 5000, 
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": true,
        "project": "BPVA",
        "mode": "offline"
    },

    "rename_map": {}
}

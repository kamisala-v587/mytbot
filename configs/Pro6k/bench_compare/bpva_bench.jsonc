{
    // Benchmark-only copy of configs/Pro6k/bpva_sft_robotwin.jsonc.
    // Only dataset.repo_id_file / num_workers are overridden so the bpva vs
    // TBot_SA1 throughput comparison uses the same dataset and worker count.
    // Do NOT use this file for real training.
    "dataset": {
        "type": "bpva",
        "repo_id": "bpva_bench_data",
        "repo_id_file":"/vla/workspace/my_tbot/configs/ds_ids/Baidunyun/pretrain_data_ids_baiduyun_test_3cam.txt",
        "action_mode": "delta",
        "use_external_stats": false,
        "external_stats_root": null,
        "use_imagenet_stats": true,
        "video_backend": "pyav",
        "streaming": false,
        "dist_loading": true,
        "skip_video_file_validation": true,
        "weight_rules_path": null,
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "qwen3_vl_processor_path": "/vla/workspace/models/Qwen3-VL-2B-Instruct",

        "bp_num_chunks": 10,
        "bp_same_episode_policy": "avoid",
        "bp_seed": 0,
        "bp_camera_keys": [
            "observation.images.image0",
            "observation.images.image1",
            "observation.images.image2"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpva",
        "pretrained_path": "/vla/workspace/models/BPVA/pretrain-v1-4w",
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "qwen3_vl_variant": "qwen3_vl_28l",
        "action_expert_variant": "qwen3_28l",
        "qwen3_vl_pretrained_path": "/vla/workspace/models/Qwen3-VL-2B-Instruct",

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "attention_mask_mode": "default",

        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [-15, 0, 15],
        "tokenizer_max_length": 48,

        "bp_num_chunks": 10,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0",
            "observation.images.image1",
            "observation.images.image2"
        ],
        "bp_vision_model_name": "vit_base_patch16_clip_224.openai",
        "bp_vision_checkpoint_path": "/vla/workspace/models/timm-vit_base_patch16_clip_224.openai/open_clip_model.safetensors",
        "bp_vision_pretrained": true,
        "bp_token_dim": 768,
        "bp_image_feature_aggregation": "cls",
        "bp_share_rgb_model": true,
        "bp_use_vision_norm": true,
        "bp_freeze_vision_encoder": false,
        "bp_use_action_step_embedding": true,
        "bp_use_modality_type_embedding": true,
        "bp_use_chunk_position_embedding": true,

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        "gradient_checkpointing": false,
        "freeze_vision_encoder": false,
        "train_expert_only": false,
        "train_vlm_only": false,

        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 125,
        "scheduler_decay_steps": 110000,
        "scheduler_decay_lr": 5e-6,

        "scale_factor": 8,
        "lambda_gen": 0.01,
        "cosmos_tokenizer_path_or_name": "/vla/workspace/models/Cosmos-Tokenizer-CI8x8",

        "enable_3d_queries": true,
        "num_3d_query_tokens": 432,
        "da3_alignment_mode": "query_decoder",
        "da3_query_resampler_layers": 1,
        "da3_query_resampler_ff_mult": 1,
        "query_layer_indices": [13, 19, 23, 27],
        "da3_variant": "auto",
        "da3_teacher_layers": [11, 15, 19, 23],
        "da3_query_dim": 2048,
        "da3_tokens_per_view": 1296,
        "da3_num_views": 3,
        "lambda_3d": 0.01,
        "da3_model_path_or_name": "/vla/workspace/models/DA3-LARGE-1.1",
        "da3_code_root": "/vla/workspace/my_tbot/third_party/Depth-Anything-3",
        "da3_teacher_process_res": 504,
        "da3_layer_weights": [1.0, 1.2, 1.4, 1.6],
        "log_da3_teacher_timing": false,

        "mask_action_dim_padding_loss": true,
        "action_loss_valid_dim": 14
    },

    "output_dir": "outputs/bpva_benchmark/compare/bpva",
    "job_name": "bpva_bench_compare",
    "resume": false,
    "seed": 42,
    "num_workers": 8,
    "batch_size": 6,
    "gradient_accumulation_steps": 1,
    "steps": 110000,
    "eval_freq": 100,
    "log_freq": 100,
    "save_checkpoint": true,
    "save_freq": 5000,
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": false,
        "project": "BPVA",
        "mode": "offline"
    },

    "rename_map": {}
}

{ 
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpvav2",
        "repo_id": "/multi-sft/data/jiaren/datasets/tbot-sa1-session0-joints",
        "repo_id_file": null,
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_path": "/multi-sft/data/jiaren/stats/tbot-sa1/delta/tbot-sa1-session0-joints/stats.json",
        "use_imagenet_stats": true,
        "video_backend": "pyav", 
        "homogeneous_batch": false,
        "skip_video_file_validation": false,
        "streaming": false,
        "dist_loading": false,
        "weight_rules_path": null,
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "qwen3_vl_processor_path": "/vla/workspace/models/Qwen3-VL-2B-Instruct",

        "bp_num_chunks": 8,
        "bp_camera_keys": [
            "observation.images.image0"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpvav2",
        "pretrained_path": "/vla/workspace/models/BPVA/v2/sft-robotwin_10+10w", // RoboTwin BPVAv2 weights-only；不是 TBot 训练状态续训
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "qwen3_vl_variant": "qwen3_vl_28l",
        "action_expert_variant": "qwen3_28l",
        "qwen3_vl_pretrained_path": "/vla/workspace/models/Qwen3-VL-2B-Instruct",

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "attention_mask_mode": "default",
        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [-15, 0, 15],

        // 以下 BP 字段决定 checkpoint 参数结构，不能随意改变，否则 pretrained 加载会结构不兼容。
        "bp_num_chunks": 8,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "bp_encoder_version": "query_compressor_v1",
        "bp_freeze_shared_visual": true,
        "bp_compressor_dim": 512,
        "bp_state_action_hidden_dim": 256,
        "bp_num_query_tokens": 8,
        "bp_compressor_num_layers": 2,
        "bp_compressor_num_heads": 8,
        "bp_compressor_ff_mult": 4,
        "bp_use_modality_type_embedding": true,
        "bp_use_camera_embedding": true,
        "bp_use_chunk_position_embedding": true,

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        "gradient_checkpointing": true,
        "freeze_vision_encoder": false,
        "train_expert_only": false,
        "train_vlm_only": false,

        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 2000,
        "scheduler_decay_steps": 30000,
        "scheduler_decay_lr": 5e-6,
        "scale_factor": 8,
        "lambda_gen": 0.01,
        "cosmos_tokenizer_path_or_name": "/vla/workspace/models/Cosmos-Tokenizer-CI8x8",

        "enable_3d_queries": true,
        "num_3d_query_tokens": 432,
        "da3_alignment_mode": "query_decoder",
        "da3_query_resampler_layers": 1,
        "da3_query_resampler_ff_mult": 1,
        "query_layer_indices": [13, 19, 23, 27],
        "da3_variant": "auto",
        "da3_teacher_layers": [11, 15, 19, 23],
        "da3_query_dim": 2048,
        "da3_tokens_per_view": 1296,
        "da3_num_views": 3,
        "lambda_3d": 0.01,
        "da3_model_path_or_name": "/vla/workspace/models/DA3-LARGE-1.1",
        "da3_code_root": "/vla/workspace/my_tbot-bpv2-sft-e3ec89a/third_party/Depth-Anything-3",
        "da3_teacher_process_res": 504,
        "da3_layer_weights": [1.0, 1.2, 1.4, 1.6],
        "log_da3_teacher_timing": true
        // 预训练不截断loss计算
    },

    "output_dir": "/vla/workspace/my_tbot/outputs/BPVAv2/session0_sft_55897",
    "job_name": "bpv2_session0_sft_55897",
    "resume": false,
    "seed": 42,
    "num_workers": 6,
    "batch_size": 12,
    "gradient_accumulation_steps": 1,
    "steps": 55897,
    "eval_freq": 1000,
    "log_freq": 1,
    "save_checkpoint": true,
    "save_freq": 10000,
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": true,
        "project": "BPVA",
        "mode": "offline"
    },

    "rename_map": {}
}

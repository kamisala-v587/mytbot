{
    // 对照组：普通 VLA（q35，无示教 / BP），与 B-4 BP 后训练同一份数据、同一份归一化统计，比较 BP 的作用。
    // 起点：q35 预训练 pt-15w（vlwa_q35 action-only，q35 可直接加载，先例 bpv3_plan/v0/stage05_q35_clean_3epoch.jsonc）
    // 数据：bp_tasks/splits/v1/train_repos.txt 的 674 个 repo（38 任务 / 8540 ep / 2,158,085 帧），与 b4_sft*.jsonc 相同
    //   -> configs/ds_ids/local/robotwin2.5_bp_train_v1.txt；语言指令即各候选集的 instruction（含目标描述）
    // 训练：ViT 冻结（freeze_vision_encoder），Qwen 语言层 + Action Expert 单一学习率 5e-5 -> 5e-6（cosine，1000 步 warmup）
    // 训练量：每步 64 帧 x 4 卡 = 256 帧，与 BP 每步 16 条 x 4 查询时刻 x 4 卡 = 256 帧相同；
    //   第 k 步与 BP 累计第 k 步看过的帧数相同（BP 累计 100k 约 11.9 epoch）
    // 启动：source tools/bpv4cdxb/env.local.sh; bash tools/bpv4cdxb/train_b2_local.sh configs/Pro6k/bpv4cdxb_plan/q35_bp_baseline.jsonc
    "dataloader_in_order": false,
    "dataset": {
        "type": "q35",
        "repo_id": "q35_bp_baseline_v1",
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/local/robotwin2.5_bp_train_v1.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        // 与 BP 后训练同一份统计（external_stats_root 要求 <root>/<robot_type>/<action_mode>/stats.json 目录结构）
        "external_stats_path": "/vla/workspace/my_tbot/norm_stats/bprobotwin_delta_h50/stats.json",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        "homogeneous_batch": false,
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": false,
        // 不设采样权重：所有帧等概率
        "weight_rules_path": null,
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,
        "image_transforms": {"enable": false, "preset": null}
    },
    "env": null,
    "policy": {
        "type": "q35",
        "pretrained_path": "/vla/workspace/models/q35/pt-15w",
        "push_to_hub": false,
        "device": null,
        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,
        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [0],
        "num_camera_views": 3,
        "empty_cameras": 0,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 0.004,
        "max_period": 4.0,
        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        // ViT 冻结（与 BP 后训练一致），其余参数（Qwen 语言层 + Action Expert）训练
        "freeze_vision_encoder": true,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",
        "normalization_mapping": {"VISUAL": "IDENTITY", "STATE": "IDENTITY", "ACTION": "IDENTITY"},
        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 1000,
        "scheduler_decay_steps": 100000,
        "scheduler_decay_lr": 5e-6
    },
    "output_dir": "/vla/workspace/my_tbot/outputs/BPv4CDX/stage_b/q35_bp_baseline",
    "job_name": "q35-bp-baseline-v1",
    "resume": false,
    "seed": 2026,
    "num_workers": 16,
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 100000,
    "eval_freq": 0,
    "log_freq": 10,
    "save_checkpoint": true,
    "save_freq": 10000,
    "use_policy_training_preset": true,
    "eval": {"n_episodes": 50, "batch_size": 50, "use_async_envs": false},
    "wandb": {"enable": false, "project": "Q35", "mode": "offline"},
    "rename_map": {}
}

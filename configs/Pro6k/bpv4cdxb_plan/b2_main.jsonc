{
    // bpv4cdx Stage B — B-2 主路径（开发文档 v1 §5.3 / B200 checklist §2）：只训 Action Expert + [obs_start]/[obs_end]，
    // 冻结 Qwen / ViT / 示教编码器；F-0 + V-full + state；同任务（同 repo + 描述文本完全一致）抽示教；
    // 5e-5 恒定学习率，看 loss / action MSE 拐角即停；每次保存跑精简 G9（heldout_monitor.jsonl）。
    // 数据：configs/et3_local.txt（本机路径）→ configs/ds_ids/local/et3_split.json → stage_b_pretrain_index.json。
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpv4cdx_b",
        "repo_id": "bpv4cdx_b2_et3",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "video_backend": "torchcodec",
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": false,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",

        "pairing": "same_task",
        "index": "/vla/workspace/my_tbot/outputs/BPv4CDX/stage_b/stage_b_pretrain_index.json",
        "data_root": "/public-data/dataset:/vla/workspace/data:/public-data/dataset/agibot-world3.0-fix/beta2025",
        "array_store": "/vla/workspace/cache/ae3_arrays_dev",
        "zdemo_dir": "/vla/workspace/cache/bpv4cdxb_zdemo/89ef6e438045",
        "cross_arm_prob": 0.5,
        "image_size": 224,
        "split": "train",
        "queries_per_item": 4,
        "contrast_prob": 0.0,
        "load_threads": 32,
        "heldout_monitor": true,
        "monitor_queries": 128,
        "image_transforms": {"enable": false, "preset": null}
    },
    "env": null,
    "policy": {
        "type": "bpv4cdx_b",
        "pretrained_path": null,
        "push_to_hub": false,
        "device": null,
        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 25,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,

        "frozen_encoder": "/vla/workspace/models/BPVA/BPv4CDX/StageA_AE_frozen/0750000",
        "num_demo_tokens": 128,
        "obs_marker_tokens": true,
        "expert_visibility": "full",
        "fusion_layers": 0,
        "demo_input": "video",
        "use_state": true,
        "state_drop_prob": 0.0,

        "new_modules_lr": 5e-5,
        "act_expert_lr": 5e-5,

        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 4e-3,
        "max_period": 4.0,
        "normalization_mapping": {"VISUAL": "IDENTITY", "STATE": "IDENTITY", "ACTION": "IDENTITY"},

        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        // 恒定 5e-5：无 warmup，decay 终点 = 峰值
        "scheduler_warmup_steps": 0,
        "scheduler_decay_steps": 1000000,
        "scheduler_decay_lr": 5e-5,

        "preflight_memory_check": true,
        "preflight_memory_limit_frac": 0.9
    },
    "output_dir": "/vla/workspace/my_tbot/outputs/BPv4CDX/stage_b/b2_main",
    "resume": false,
    "seed": 42,
    "num_workers": 8,
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "steps": 200000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 2000,
    "use_policy_training_preset": true,
    "eval": {"n_episodes": 50, "batch_size": 50, "use_async_envs": false},
    "wandb": {"enable": false, "project": "BPV4CDXB", "mode": "offline"},
    "rename_map": {}
}

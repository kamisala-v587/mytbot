// Stage0: q35 Robotwin scene adaptation, 50 tasks clean only.
// Data: 2,500 episodes, 549,787 frames.
// Train: about 13.0k optimizer steps on 4 GPUs, effective batch=64*4*1=256.
// Approx epochs: about 6.1 over this dataset.
{
    "dataloader_in_order": false,
    "dataset": {
        "type": "q35",
        "repo_id": "bpv3_plan_stage0_q35_robotwin_clean",
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/pro6k/bpv3_plan/robotwin_50_clean_local.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        "homogeneous_batch": true,
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": false,
        "weight_rules_path": "/vla/workspace/my_tbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,
        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },
    "env": null,
    "policy": {
        "type": "q35",
        "pretrained_path": "/vla/workspace/models/q35/pt-15w",
        "push_to_hub": false,
        "device": null,
        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,
        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [
            224,
            224
        ],
        "image_delta_indices": [
            0
        ],
        "num_camera_views": 3,
        "empty_cameras": 0,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 0.004,
        "max_period": 4.0,
        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",
        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },
        "optimizer_lr": 3e-05,
        "optimizer_betas": [
            0.9,
            0.95
        ],
        "optimizer_eps": 1e-08,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 1000,
        "scheduler_decay_steps": 13000,
        "scheduler_decay_lr": 3e-06
    },
    "output_dir": "outputs/BPV3Plan/stage0_q35_clean_3epoch",
    "job_name": "bpv3-plan-stage0-q35-clean-3epoch",
    "resume": false,
    "seed": 42,
    "num_workers": 16,
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 13000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 5000,
    "use_policy_training_preset": true,
    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },
    "wandb": {
        "enable": false,
        "project": "Q35",
        "mode": "offline"
    },
    "rename_map": {}
}

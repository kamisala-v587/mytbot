// Stage1: BPV3 origin BP, all 50 Robotwin tasks clean+randomized_500.
// Data: 6,075,103 frames.
// Train: about 35.0k optimizer steps on 4 GPUs, effective batch=32*4*1=128.
// Approx epochs: about 0.74 over this dataset; single-GPU batch_size=32.
{
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpvav3",
        "repo_id": "bpv3_plan_stage1_origin_robotwin50_clean_rand_0p35epoch",
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/pro6k/bpv3_plan/robotwin_50_clean_rand_local.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        "homogeneous_batch": true,
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": true,
        "weight_rules_path": "/vla/workspace/my_tbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,
        "use_language": false,
        "bp_num_chunks": 8,
        "bp_seed": 42,
        "bp_sampling_mode": "origin",
        "bp_action_use": false,
        "bp_state_use": true,
        "align_bp_encoder": false,
        "future_filter": true,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },
    "env": null,
    "policy": {
        "type": "bpvav3",
        "pretrained_path": "",
        "push_to_hub": false,
        "device": null,
        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,
        "use_language": false,
        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [
            224,
            224
        ],
        "image_delta_indices": [
            0
        ],
        "num_camera_views": 3,
        "empty_cameras": 0,
        "bp_num_chunks": 8,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "bp_compressor_dim": 512,
        "bp_state_action_hidden_dim": 256,
        "bp_num_query_tokens": 8,
        "bp_compressor_num_layers": 2,
        "bp_compressor_num_heads": 8,
        "bp_compressor_ff_mult": 4,
        "bp_align_loss_type": "cosine", // 可选 cosine 或 mse；mse 使用未归一化特征
        "lambda_bp_encoder": 0.0,
        "frozen_bp_encoder": false,
        "frozen_vit": true,
        // true 时只让 BP 图像不给共享 ViT 回传梯度，当前观测仍训练 ViT。需配合 frozen_vit=false 才有意义。
        "frozen_bp_vit": false,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 0.004,
        "max_period": 4.0,
        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",
        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },
        "optimizer_lr": 2e-05,
        "optimizer_betas": [
            0.9,
            0.95
        ],
        "optimizer_eps": 1e-08,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 1000,
        "scheduler_decay_steps": 20000,
        "scheduler_decay_lr": 2e-06
    },
    "output_dir": "outputs/BPV3Plan/q35/stage1_origin_robotwin50_clean_rand_0p35epoch",
    "job_name": "bpv3-plan-q35-stage1-origin-robotwin50-clean-rand-0p35epoch",
    "resume": false,
    "seed": 42,
    "num_workers": 16,
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 20000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 5000,
    "use_policy_training_preset": true,
    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },
    "wandb": {
        "enable": false,
        "project": "BPVAv3",
        "mode": "offline"
    },
    "rename_map": {}
}

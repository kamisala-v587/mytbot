{
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpvav3",
        "repo_id": "bprobotwin_clean",
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/pro6k/robo_clean_bp.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        "homogeneous_batch": true,
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": false,
        "weight_rules_path": "/vla/workspace/my_tbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,

        // false 时当前观测不编码 instruction，也不调用 tokenizer。
        "use_language": false,
        "bp_num_chunks": 8,
        "bp_seed": 0,
        // random: 同任务随机，可能抽到当前 episode。
        // origin: 示教就是当前轨迹整段。阶段 1 用，并且 lambda_bp_encoder 必须为 0。
        // avoid: 同任务随机，排除当前 episode。阶段 2 用。
        "bp_sampling_mode": "random",

        // false: 示教 action 整段置零且 action_is_pad=true。条件只留图像和 state。
        // 只保留部分维度写 "0:6" 或 "0:6,7:13"（右端不含）。Aloha 夹爪是 6 和 13。
        "bp_action_use": false,
        // 与 bp_action_use 相同。false 时 state 置零且 state_is_available=false。
        "bp_state_use": true,

        // 本轮 stage2 先不开 align。训练时按 bp_action_use / bp_state_use 选择示教维度。
        "align_bp_encoder": false,

        // 只过滤 future_prompt 里锚点早于当前帧的 chunk。
        "future_filter": true,
        "bp_camera_keys": [
            "observation.images.image0"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpvav3",
        // stage1 跑完后改成实际 003000（loss 仍明显下降则用 004000）。
        "pretrained_path": "/vla/workspace/my_tbot/outputs/BPv3/q35/bpv3-clean-stage1/checkpoints/003000/pretrained_model", 
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,

        "use_language": false,

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [0],
        "num_camera_views": 3,
        "empty_cameras": 0,

        "bp_num_chunks": 8,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "bp_compressor_dim": 512,
        "bp_state_action_hidden_dim": 256,
        "bp_num_query_tokens": 8,
        "bp_compressor_num_layers": 2,
        "bp_compressor_num_heads": 8,
        "bp_compressor_ff_mult": 4,
        // 本轮先只训 action。避免 align 探针和接模块的效果搅在一起。
        "bp_align_loss_type": "cosine", // 可选 cosine 或 mse；mse 使用未归一化特征
        "lambda_bp_encoder": 0,
        // true 时只冻结 bp_obs_encoder 里 ViT 以外的部分：投影、MLP 和 compressor。
        "frozen_bp_encoder": false,
        // true 时冻结共享 Qwen3.5 ViT。当前观测和 BP 图像是同一份参数，两边都不再更新。
        "frozen_vit": true,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 4e-3,
        "max_period": 4.0,

        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 200,
        "scheduler_decay_steps": 7000,
        "scheduler_decay_lr": 5e-6
    },

    "output_dir": "outputs/BPv3/q35/bpv3-clean-stage2",
    "resume": false,
    "seed": 42,
    "num_workers": 16,
    // 单卡 64；4 卡时全局 batch=256，和上次 clean SFT 同量级。
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 7000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 1000,
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": false,
        "project": "BPVAv3",
        "mode": "offline"
    },

    "rename_map": {}
}

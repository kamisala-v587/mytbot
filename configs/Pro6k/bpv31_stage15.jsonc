{
    // BPVAv3.1 stage1.5：对标 taskcon / ex01 stage1.5（random、19k、warmup200/decay7000→5e-6）。
    // 从本目录 stage1 的 3k ckpt 续训；跑完 stage1 后把 pretrained_path 换成实际时间戳目录。
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpvav31",
        "repo_id": "bprobotwin_clean",
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/pro6k/robo_clean_bp.txt",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "use_imagenet_stats": true,
        "video_backend": "torchcodec",
        "homogeneous_batch": false,
        "skip_video_file_validation": true,
        "streaming": false,
        // 对比损失下保持 false，避免各卡任务集合不重叠。
        "dist_loading": false,
        "weight_rules_path": "/vla/workspace/my_tbot/configs/ds_ids/weight_rules.yaml",
        "height": 224,
        "width": 224,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "current_image_index": 0,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_processor_revision": null,

        "use_language": false,
        "bp_num_chunks": 8,
        "bp_fixed_num_chunks": true,
        "bp_attach_task_id": true,
        "bp_attach_retrieval": true,
        "bp_seed": 0,
        // 与 taskcon / ex01 stage1.5 一致：同任务随机示教（可含当前 episode）。
        "bp_sampling_mode": "random",

        // stage1.5 打开 BP action，让关键帧携带“之后怎么动”。
        "bp_action_use": true,
        "bp_state_use": true,

        "align_bp_encoder": false,
        "future_filter": true,
        "bp_camera_keys": [
            "observation.images.image0"
        ],

        "image_transforms": {
            "enable": false,
            "preset": null
        }
    },

    "env": null,
    "policy": {
        "type": "bpvav31",
        // TODO: stage1 跑完后改成实际路径，例如
        // .../BPV3Plan/v3.1/stage1/<timestamp>/checkpoints/003000/pretrained_model
        "pretrained_path": "/vla/workspace/my_tbot/outputs/BPV3Plan/v3.1/stage1/checkpoints/003000/pretrained_model",
        "push_to_hub": false,
        "device": null,

        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,

        "use_language": false,

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "image_resolution": [224, 224],
        "image_delta_indices": [0],
        "num_camera_views": 3,
        "empty_cameras": 0,

        "bp_num_chunks": 8,
        "bp_fixed_num_chunks": true,
        "bp_action_chunk_size": 50,
        "bp_camera_keys": [
            "observation.images.image0"
        ],
        "bp_compressor_dim": 512,
        "bp_state_action_hidden_dim": 256,
        "bp_num_query_tokens": 8,
        "bp_compressor_num_layers": 2,
        "bp_compressor_num_heads": 8,
        "bp_compressor_ff_mult": 4,
        "bp_align_loss_type": "cosine",
        "lambda_bp_encoder": 0,

        "lambda_bp_task": 0.05,
        "bp_task_tau": 0.2,
        "bp_task_proj_dim": 256,
        "lambda_bp_retrieve": 0.1,
        "bp_retrieve_tau": 0.1,
        "lambda_bp_next_state": 0.05,
        "lambda_bp_temporal": 0.05,
        "bp_temporal_tau": 0.2,
        "bp_temporal_progress_tol": 0.15,
        "bp_use_progress_encoding": true,

        "frozen_bp_encoder": false,
        "frozen_vit": true,
        "frozen_bp_vit": false,
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 4e-3,
        "max_period": 4.0,

        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",

        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "IDENTITY",
            "ACTION": "IDENTITY"
        },

        // 与 taskcon / ex01 stage1.5 相同。
        "optimizer_lr": 5e-5,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 200,
        "scheduler_decay_steps": 7000,
        "scheduler_decay_lr": 5e-6
    },

    "output_dir": "/vla/workspace/my_tbot/outputs/BPV3Plan/v3.1/stage1.5",
    "resume": false,
    "seed": 42,
    "num_workers": 16,
    "batch_size": 64,
    "gradient_accumulation_steps": 1,
    "steps": 19000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 1000,
    "use_policy_training_preset": true,

    "eval": {
        "n_episodes": 50,
        "batch_size": 50,
        "use_async_envs": false
    },

    "wandb": {
        "enable": false,
        "project": "BPVAv31",
        "mode": "offline"
    },

    "rename_map": {}
}

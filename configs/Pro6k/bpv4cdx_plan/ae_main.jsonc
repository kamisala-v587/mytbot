{
    // bpv4cdx Stage A-AE 主分支（S-A / P5 / 无 state / N128）。设计见
    // code/conclusion/bpv4/bpv4CDX分支-不要混bpv4方案/bpv4cdx 开发任务书 v1.md。
    // 路径默认值是开发机的；训练机上由 tools/bpv4cdx/train.sh 用命令行覆盖（DATA_ROOT / CACHE_DIR / QWEN_PATH / OUT_ROOT）。
    "dataloader_in_order": false,
    "dataset": {
        "type": "bpv4cdx_ae",
        "repo_id": "bpv4cdx_ae_train",
        // 相对名 <task>/<variant>，与 bpv4_bpen 相同的 100 个 repo（50 任务 × clean_50 + randomized_100）
        "repo_id_file": "/vla/workspace/my_tbot/configs/ds_ids/pro6k/bpv4cdx_train_rel.txt",
        "data_root": "/vla/workspace/data/robotwin2.0",
        "action_mode": "delta",
        "use_external_stats": true,
        "external_stats_root": "/vla/workspace/my_tbot/norm_stats",
        "video_backend": "torchcodec",
        "skip_video_file_validation": true,
        "streaming": false,
        "dist_loading": false,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "qwen3_5_processor_path": "/vla/workspace/models/q35/base_800m",

        // 50% canonical text（任务名生成）/ 50% generic text
        "generic_text_prob": 0.5,
        "language_max_length": 24,

        // 32 个槽，S-A 采样（bpv4 自适应 v2 + 强制活动区间起点），缓存由 BPV4CDX.build_cache 生成
        "num_slots": 32,
        "sampler": "sa",
        "cache_dir": "/vla/workspace/cache/bpv4cdx_sa",
        "spatial_tokens": 5,

        // 每条轨迹 4 个 50 步目标段（按时间分 4 层各取一个起点）
        "segment_len": 50,
        "segments_per_trajectory": 4,
        "segment_mode": "random",

        "val_holdout_last": {"clean_50": 5, "randomized_100": 10},
        "split": "train",
        "episode_whitelist": [],
        "max_trajectories": 0,

        "image_transforms": {"enable": false, "preset": null}
    },

    "env": null,
    "policy": {
        "type": "bpv4cdx_ae",
        // 不加载任何 VLA 权重：Qwen3.5-0.8B base 冻结，action expert 与新模块随机初始化
        "pretrained_path": null,
        "push_to_hub": false,
        "device": null,
        "dtype": "bfloat16",
        "expert_type": "action",
        "qwen3_5_pretrained_path": "/vla/workspace/models/q35/base_800m",
        "qwen3_5_model_revision": null,
        "qwen3_5_processor_path": null,
        "qwen3_5_processor_revision": null,
        "qwen3_5_fingerprint": null,
        "expert_width_ratio": 0.5,

        "n_obs_steps": 1,
        "chunk_size": 50,
        "n_action_steps": 50,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,

        // Temporal Video Q-Former：32 槽 × 3 相机 × 5 token = 480 个输入 token → 128 个按时间排列的 token（每槽 4 个）
        "num_slots": 32,
        "num_cameras": 3,
        "visual_dim": 1024,
        "spatial_tokens": 5,
        "num_demo_tokens": 128,
        "qformer_dim": 512,
        "qformer_num_layers": 2,
        "qformer_num_heads": 8,
        "qformer_ff_mult": 4,

        "demo_input": "video",
        "expert_context": "segment_query",
        "use_segment_start_state": false,
        "segment_start_state_mask_prob": 0.5,

        // Qwen 主体全程冻结，不使用 LoRA；新模块与 action expert 1e-4
        "new_modules_lr": 1e-4,
        "act_expert_lr": 1e-4,

        "attention_implementation": "sdpa",
        "gradient_checkpointing": false,
        "causal_vlm": false,
        "compile_model": false,
        "compile_mode": "default",
        "time_sampling_beta_alpha": 1.5,
        "time_sampling_beta_beta": 1.0,
        "time_sampling_scale": 0.999,
        "time_sampling_offset": 0.001,
        "min_period": 4e-3,
        "max_period": 4.0,
        "normalization_mapping": {"VISUAL": "IDENTITY", "STATE": "IDENTITY", "ACTION": "IDENTITY"},

        "optimizer_lr": 1e-4,
        "optimizer_betas": [0.9, 0.95],
        "optimizer_eps": 1e-8,
        "optimizer_weight_decay": 0.01,
        "optimizer_grad_clip_norm": 1.0,
        "scheduler_warmup_steps": 500,
        "scheduler_decay_steps": 10000,
        "scheduler_decay_lr": 1e-5,

        "preflight_memory_check": true,
        "preflight_memory_limit_frac": 0.9
    },

    "output_dir": "/vla/workspace/my_tbot/outputs/BPv4CDX/stage_a/ae_main",
    "resume": false,
    "seed": 42,
    "num_workers": 12,
    // 每 rank 16 条轨迹 × 4 个目标段 = 64 个样本
    "batch_size": 16,
    "gradient_accumulation_steps": 1,
    "steps": 10000,
    "eval_freq": 0,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 2500,
    "use_policy_training_preset": true,

    "eval": {"n_episodes": 50, "batch_size": 50, "use_async_envs": false},
    "wandb": {"enable": false, "project": "BPV4CDX", "mode": "offline"},
    "rename_map": {}
}
